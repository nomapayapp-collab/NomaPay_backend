DATABASE_URL=postgresql://postgres:tu-pasword@localhost:5432/nomapay
CORS_ORIGINS=
JWT_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
GOOGLE_CLIENT_ID=

# Wallet operations (compra/venta/exchange)
LOCAL_CURRENCY=ARS
TRANSACTION_FEE_PERCENTAGE=0.5

# Exchange rate API
EXCHANGE_RATE_API_BASE_URL=https://open.er-api.com/v6/latest
FALLBACK_EXCHANGE_RATE_API_BASE_URL= https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies
EXCHANGE_RATE_CACHE_TTL_MS=3600000

# AWS SES
SES_ENABLED=true
SES_SOURCE_EMAIL=tu-email-verificado@dominio.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

MAIL_SERVICE_ENABLED=true
MAIL_SERVICE_URL= es la URL BASE de esa Vercel Function, SIN el /api/send-mail al final.
MAIL_INTERNAL_SECRET=
